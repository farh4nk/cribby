# Daemon base URL (Dev 1's FastAPI service). Use http://<pi-ip>:8000 when it runs on the Pi.
NEXT_PUBLIC_DAEMON_URL=http://localhost:8000
# Only when a separate Pi owns the speaker/mic/camera (Pi = camera, Mac = Presage); leave unset for one box.
# NEXT_PUBLIC_EDGE_URL=http://<pi-tailscale-ip>:8000

# Analytics & Gemini summary server (Dev 4's backend service)
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8001

# Optional: a real relaxing-music track for auto-soothe (e.g. /soothe-music.mp3 in web/public).
# Unset = the built-in lullaby.
# NEXT_PUBLIC_SOOTHE_MUSIC_URL=/soothe-music.mp3

# 1 = generate fake telemetry in the browser; no daemon needed.
NEXT_PUBLIC_MOCK=0

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
AUTH_SECRET=your_random_32_character_secret_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# High-vitals desktop alert (optional overrides; defaults shown). Needs "Desktop alerts" turned on
# in the activity log. For a quick demo: BRPM_HIGH=30, SUSTAIN_S=5, SIMULATED=1.
# NEXT_PUBLIC_ALERT_BRPM_HIGH=60
# NEXT_PUBLIC_ALERT_BPM_HIGH=180
# NEXT_PUBLIC_ALERT_SUSTAIN_S=30
# NEXT_PUBLIC_ALERT_COOLDOWN_S=600
# NEXT_PUBLIC_ALERT_SIMULATED=0
